   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pod) (rate(vllm:nixl_xfer_time_seconds_sum[1m])) / sum by (pod) (rate(vllm:nixl_xfer_time_seconds_count[1m]))",
     "legendFormat": "{{pod}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
