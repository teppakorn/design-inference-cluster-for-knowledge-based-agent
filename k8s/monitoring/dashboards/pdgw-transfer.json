{
 "uid": "pdgw-transfer",
 "title": "PD Gateway / KV transfer (NIXL + Mooncake)",
 "schemaVersion": 39,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "timezone": "browser",
 "refresh": "5s",
 "tags": [
  "pd-gateway"
 ],
 "graphTooltip": 1,
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "NIXL bytes / s (prefill pushes to decode)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 8,
      "lineWidth": 1,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pod) (rate(vllm:nixl_bytes_transferred_sum[1m]))",
     "legendFormat": "{{pod}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "NIXL mean transfer time",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 8,
      "lineWidth": 1,
      "showPoints": "never"
