    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pod) (rate(vllm:nixl_xfer_time_seconds_count[1m]))",
     "legendFormat": "pushes {{pod}}"
    }
   ]
