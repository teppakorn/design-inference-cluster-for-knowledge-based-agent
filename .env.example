# Copy to .env (never commit .env). Every line is optional; config.sh holds the defaults.

# Hugging Face token: only needed for gated models (Qwen models are not gated).
# HF_TOKEN=hf_...

# Model
# MODEL=Qwen/Qwen3.5-4B
# THINKING=1

# Mooncake transport: 1 = RDMA (RoCE / InfiniBand NIC), 0 = TCP
# MOONCAKE_RDMA=1
# MOONCAKE_DEVICE=mlx5_0
# MOONCAKE_GID_INDEX=3
# MOONCAKE_SEGMENT=40GB

# Wiki tools: a folder of Markdown notes the chat model can search (Open WebUI)
# WIKI_DIR=/path/to/notes
# WIKI_DESCRIPTION="research reports"

# Gateway
# ADMISSION=all
# SLO_S=26
# QUEUE_POLICY=two-class
# ROUTER_POLICY=prefix-load
# CACHE_SALT=off
